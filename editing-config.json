{
	"./widgets/webwriter-quiz": {
		"content": "quiz-task*"
	},
	"./widgets/webwriter-quiz-hint": {
		"group": "containerinline",
		"isolating": true,
		"content": "p+",
		"uninsertable": true
	},
	"./widgets/webwriter-true-false": {
		"group": "quiz-task",
		"isolating": true,
		"uninsertable": true,
		"content": "webwriter-quiz-hint? p"
	},
	"./widgets/webwriter-choice": {
		"group": "quiz-task",
		"uninsertable": true,
		"content": "webwriter-quiz-hint? p webwriter-choice-item+"
	},
	"./widgets/webwriter-choice-item": {
		"isolating": false,
		"content": "webwriter-quiz-hint? (p | flow)+",
		"uninsertable": true
	},
	"./widgets/webwriter-order": {
		"group": "quiz-task",
		"uninsertable": true,
		"content": "webwriter-quiz-hint? p webwriter-order-item+"
	},
	"./widgets/webwriter-order-item": {
		"isolating": false,
		"content": "webwriter-quiz-hint? (p | flow)+",
		"uninsertable": true
	},
	"./widgets/webwriter-speech": {
		"group": "quiz-task",
		"uninsertable": true,
		"content": "webwriter-quiz-hint? p"
	},
	"./widgets/webwriter-text": {
		"group": "quiz-task",
		"isolating": true,
		"uninsertable": true,
		"content": "webwriter-quiz-hint? p"
	},
	"./widgets/webwriter-gap": {
		"group": "quiz-task",
		"isolating": true,
		"content": "webwriter-quiz-hint? p (p | flow)+",
		"uninsertable": true
	},
	"./widgets/webwriter-mark": {
		"group": "quiz-task",
		"isolating": true,
		"content": "webwriter-quiz-hint? p p",
		"marks": "",
		"uninsertable": true
	},
	"./widgets/webwriter-pairing": {
		"group": "quiz-task",
		"isolating": true,
		"content": "webwriter-quiz-hint? p webwriter-pairing-item*",
		"uninsertable": true
	},
	"./widgets/webwriter-pairing-item": {
		"group": "",
		"isolating": true,
		"content": "(p | picture)",
		"uninsertable": true,
		"propagateEvents": [
			"mousedown",
			"keydown",
			"keypress",
			"keyup",
			"beforeinput",
			"input",
			"compositionstart",
			"compositionupdate",
			"compositionend"
		]
	},
	"./widgets/webwriter-gap-item": {
		"group": "phrasing",
		"inline": true,
		"isolating": false,
		"content": "text*",
		"marks": "",
		"uninsertable": true
	}
}
