{
  "name": "@webwriter/quiz",
  "version": "3.0.0",
  "type": "module",
  "description": "Add interactive tasks (multiple choice, order, free text, highlighting, or speech input). Make a quiz out of multiple tasks.",
  "keywords": [
    "webwriter-widget",
    "widget-practical",
    "widget-lang-en-US",
    "widget-lang-de-DE",
    "widget-lang-fr-FR",
    "widget-lang-es-ES",
    "widget-lang-it",
    "widget-lang-nl",
    "isced2011-1",
    "isced2011-2",
    "isced2011-3",
    "isced2011-4",
    "isced2011-5",
    "isced2011-6",
    "isced2011-7",
    "isced2011-8",
    "quiz",
    "choice",
    "test"
  ],
  "license": "MIT",
  "author": "Frederic Salmen <frederic@fsalmen.de>",
  "repository": "https://github.com/webwriter-app/quiz",
  "scripts": {
    "prepublishOnly": "build && node scripts/build-exports.mjs && npm run build:api",
    "build:api": "tsc -p tsconfig.api.json && tsc -p tsconfig.task.json",
    "dev": "build dev",
    "localize": "npx @lit/localize-tools extract && npx @lit/localize-tools build",
    "localize:apply": "node scripts/apply-translations.mjs"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@shoelace-style/shoelace": "^2.20.1",
    "@webwriter/lit": "^3.0.0",
    "bootstrap-icons": "^1.13.1",
    "lit": "^3"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8",
    "@webwriter/build": "^1.13.1",
    "typescript": "~5.9.0"
  },
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "source": "./src/api/index.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./task": {
      "types": "./dist/types/src/widgets/webwriter-task.d.ts",
      "source": "./src/widgets/webwriter-task.ts",
      "default": "./dist/task.js"
    },
    "./widgets/webwriter-quiz.*": {
      "source": "./src/widgets/webwriter-quiz.ts",
      "default": "./dist/widgets/webwriter-quiz.*"
    },
    "./widgets/webwriter-quiz-hint.*": {
      "source": "./src/widgets/webwriter-quiz-hint.ts",
      "default": "./dist/widgets/webwriter-quiz-hint.*"
    },
    "./widgets/webwriter-true-false.*": {
      "source": "./src/widgets/choice/webwriter-true-false.ts",
      "default": "./dist/widgets/webwriter-true-false.*"
    },
    "./widgets/webwriter-choice.*": {
      "source": "./src/widgets/choice/webwriter-choice.ts",
      "default": "./dist/widgets/webwriter-choice.*"
    },
    "./widgets/webwriter-choice-item.*": {
      "source": "./src/widgets/choice/webwriter-choice-item.ts",
      "default": "./dist/widgets/webwriter-choice-item.*"
    },
    "./widgets/webwriter-order.*": {
      "source": "./src/widgets/order/webwriter-order.ts",
      "default": "./dist/widgets/webwriter-order.*"
    },
    "./widgets/webwriter-order-item.*": {
      "source": "./src/widgets/order/webwriter-order-item.ts",
      "default": "./dist/widgets/webwriter-order-item.*"
    },
    "./widgets/webwriter-speech.*": {
      "source": "./src/widgets/speech/webwriter-speech.ts",
      "default": "./dist/widgets/webwriter-speech.*"
    },
    "./widgets/webwriter-text.*": {
      "source": "./src/widgets/webwriter-text.ts",
      "default": "./dist/widgets/webwriter-text.*"
    },
    "./widgets/webwriter-mark.*": {
      "source": "./src/widgets/webwriter-mark.ts",
      "default": "./dist/widgets/webwriter-mark.*"
    },
    "./widgets/webwriter-gap.*": {
      "source": "./src/widgets/gap/webwriter-gap.ts",
      "default": "./dist/widgets/webwriter-gap.*"
    },
    "./widgets/webwriter-gap-item.*": {
      "source": "./src/widgets/gap/webwriter-gap-item.ts",
      "default": "./dist/widgets/webwriter-gap-item.*"
    },
    "./widgets/webwriter-pairing.*": {
      "source": "./src/widgets/pairing/webwriter-pairing.ts",
      "default": "./dist/widgets/webwriter-pairing.*"
    },
    "./widgets/webwriter-pairing-item.*": {
      "source": "./src/widgets/pairing/webwriter-pairing-item.ts",
      "default": "./dist/widgets/webwriter-pairing-item.*"
    },
    "./tests/quiz.*": {
      "source": "./src/tests/quiz.ts",
      "default": "./dist/tests/quiz.*"
    },
    "./snippets/true-or-false.html": "./src/snippets/true-or-false.html",
    "./snippets/single-choice.html": "./src/snippets/single-choice.html",
    "./snippets/multiple-choice.html": "./src/snippets/multiple-choice.html",
    "./snippets/order.html": "./src/snippets/order.html",
    "./snippets/text.html": "./src/snippets/text.html",
    "./snippets/mark.html": "./src/snippets/mark.html",
    "./snippets/speech.html": "./src/snippets/speech.html",
    "./snippets/gap.html": "./src/snippets/gap.html",
    "./snippets/pairing.html": "./src/snippets/pairing.html",
    "./icon": "./icon.svg",
    "./editing-config.json": "./editing-config.json",
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json"
}
